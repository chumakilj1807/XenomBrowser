<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="56dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="4dp" android:paddingEnd="4dp"
    android:background="?attr/selectableItemBackground">
    <TextView android:id="@+id/tv_bookmark_title"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="@color/text"
        android:textSize="13sp" android:maxLines="2" android:ellipsize="end"
        android:paddingEnd="8dp"/>
    <ImageButton android:id="@+id/btn_delete_bookmark"
        android:layout_width="36dp" android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="@color/text_hint" android:contentDescription="Delete"/>
</LinearLayout>
